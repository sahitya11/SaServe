rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Restrict read and write access to the 'users/{userId}' collection
    // so that only the authenticated user matching that {userId} can access their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
