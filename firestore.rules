rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Restrict read and write access to the 'users/{userId}' collection
    // so that only the authenticated user matching that {userId} can access their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Service Providers: readable and writable for specialist catalog synchronization
    match /providers/{providerId} {
      allow read, write: if true;
    }

    // Bookings: readable and writable for service appointments & status tracking
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Feedback: readable and writable for customer feedback and quality reviews
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }
  }
}
